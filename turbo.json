{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/schemas/generated/**"]
    },
    "test:acceptance": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "test:fuzz": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["FUZZ_ITERATIONS"]
    }
  }
}

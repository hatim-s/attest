{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".prettierrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "$TURBO_ROOT$/packages/schemas/generated/**"]
    },
    "test:fuzz": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["FUZZ_ITERATIONS"]
    }
  }
}

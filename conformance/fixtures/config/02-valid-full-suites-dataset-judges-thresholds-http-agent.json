{
  "description": "Accepts HTTP invocation, inline and dataset suites, a judge threshold, and an assertion metric.",
  "expect": "valid",
  "input": {
    "config_version": 1,
    "project": "support-agent",
    "agent": {
      "type": "http",
      "url": "https://agent.example.com/invoke",
      "env": ["AGENT_TOKEN"],
      "timeout_ms": 60000,
      "retries": 1
    },
    "suites": [
      {
        "name": "smoke",
        "metrics": ["answer-correctness", "output-exists"],
        "cases": [
          {
            "id": "greeting",
            "input": { "question": "What is the capital of France?" },
            "expected": { "answer": "Paris" },
            "params": { "locale": "en" }
          }
        ]
      },
      {
        "name": "regression",
        "metrics": ["answer-correctness"],
        "dataset": "./datasets/regression.jsonl"
      }
    ],
    "metrics": [
      {
        "name": "answer-correctness",
        "type": "judge",
        "model": "example/judge",
        "rubric": "Score factual consistency.",
        "threshold": 0.75
      },
      {
        "name": "output-exists",
        "type": "assertion",
        "assert": [{ "exists": { "path": "$.output" } }]
      }
    ],
    "run": { "concurrency": 4, "timeout_ms": 30000, "output_cap_bytes": 10485760 }
  }
}

{
  "description": "Rejects duplicate inline case identifiers within the same suite.",
  "expect": "invalid",
  "issue_paths": [["suites", "0", "cases", "1", "id"]],
  "input": {
    "config_version": 1,
    "agent": { "type": "cli", "command": ["bun", "run", "agent.ts"] },
    "suites": [
      {
        "name": "smoke",
        "metrics": ["output-exists"],
        "cases": [{ "id": "same", "input": {} }, { "id": "same", "input": {} }]
      }
    ],
    "metrics": [
      {
        "name": "output-exists",
        "type": "assertion",
        "assert": [{ "exists": { "path": "$.output" } }]
      }
    ]
  }
}

{
  "description": "Rejects an HTTP agent target whose URL uses a non-HTTP scheme.",
  "expect": "invalid",
  "issue_paths": [["agent", "url"]],
  "input": {
    "config_version": 1,
    "agent": { "type": "http", "url": "ftp://agent.example.com/invoke" },
    "suites": [
      {
        "name": "smoke",
        "metrics": ["output-exists"],
        "cases": [{ "id": "greeting", "input": {} }]
      }
    ],
    "metrics": [
      {
        "name": "output-exists",
        "type": "assertion",
        "assert": [{ "exists": { "path": "$.output" } }]
      }
    ]
  }
}

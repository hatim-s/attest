{
  "description": "Accepts the smallest config with a CLI agent, one inline case, and one assertion metric.",
  "expect": "valid",
  "input": {
    "config_version": 1,
    "agent": { "type": "cli", "command": ["bun", "run", "src/agent.ts"] },
    "suites": [
      {
        "name": "smoke",
        "metrics": ["output-exists"],
        "cases": [{ "id": "greeting", "input": { "question": "Hello?" } }]
      }
    ],
    "metrics": [
      {
        "name": "output-exists",
        "type": "assertion",
        "assert": [{ "exists": { "path": "$.output" } }]
      }
    ]
  }
}

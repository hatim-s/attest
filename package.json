{
  "name": "attest-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "conformance"
  ],
  "engines": {
    "node": ">=22.15.0",
    "bun": ">=1.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && bun run typecheck:scripts",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "turbo run test --concurrency=1",
    "generate:schemas": "turbo run generate --filter=@attest/schemas",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:fix": "eslint --fix .",
    "test:fuzz": "turbo run test:fuzz --filter=@attest/conformance",
    "release:pack": "bun run build && bun run generate:schemas && bun scripts/pack-release.ts",
    "release:check": "bun run release:pack && bun scripts/check-release.ts",
    "typecheck:scripts": "effect-tsgo tsc@7.0.2 --noEmit -p scripts/tsconfig.json",
    "test:portability": "bun run --cwd packages/executor test:node && bun run --cwd packages/executor test:bun && bun run --cwd packages/runtime test:node && bun run --cwd packages/runtime test:bun",
    "test:acceptance": "bun run build && bun run --cwd packages/cli test:acceptance",
    "test:lint-rules": "node tools/anti-slop/_tests_/run.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^3"
  }
}

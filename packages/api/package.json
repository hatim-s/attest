{
  "name": "@attest/api",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    }
  },
  "dependencies": {
    "@attest/core": "workspace:*",
    "hono": "^4.13.0",
    "zod": "^4"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/block-source-publish.mjs"
  },
  "devDependencies": {
    "vitest": "^3"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"

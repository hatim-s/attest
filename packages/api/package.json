  "description": "Read API contract, server app and typed client for Attest run data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatim-s/attest.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/hatim-s/attest#readme",
  "bugs": {
    "url": "https://github.com/hatim-s/attest/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22.15.0",
    "bun": ">=1.4"
  }
}

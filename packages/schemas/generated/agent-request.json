{
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "additionalProperties": {},
      "type": "object"
    }
  ],
  "dependentRequired": {
    "conversation_id": [
      "messages",
      "turn_index"
    ],
    "messages": [
      "turn_index",
      "conversation_id"
    ],
    "turn_index": [
      "messages",
      "conversation_id"
    ]
  },
  "properties": {
    "callback": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "token": {
              "minLength": 1,
              "type": "string"
            },
            "url": {
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "url",
            "token"
          ],
          "type": "object"
        },
        {
          "not": {}
        }
      ]
    },
    "case_id": {
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "not": {}
        }
      ]
    },
    "input": {},
    "messages": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ],
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ],
            "type": "object"
          },
          "type": "array"
        },
        {
          "not": {}
        }
      ]
    },
    "params": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "not": {}
        }
      ]
    },
    "protocol": {
      "enum": [
        "attest.agent-invocation"
      ],
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    },
    "turn_index": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "not": {}
        }
      ]
    }
  },
  "required": [
    "protocol",
    "run_id",
    "case_id",
    "input"
  ],
  "type": "object"
}

{
  "$comment": "Runtime-only invariants include span time ordering, duplicate identifiers, and metric references.",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "eval.cancel",
          "type": "string"
        },
        "ok": {
          "const": true,
          "type": "boolean"
        },
        "project_hash_after": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_hash_before": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "format": "ulid",
              "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
              "type": "string"
            },
            "status": {
              "enum": [
                "cancellation_requested",
                "already_cancelled",
                "already_terminal"
              ],
              "type": "string"
            }
          },
          "required": [
            "run_id",
            "status"
          ],
          "type": "object"
        },
        "schema": {
          "const": "attest.cli-result",
          "type": "string"
        },
        "warnings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "minLength": 1,
                "type": "string"
              },
              "details": {
                "$ref": "#/$defs/__schema0"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "ok",
        "command",
        "project_hash_before",
        "project_hash_after",
        "result",
        "warnings"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "eval.cancel",
          "type": "string"
        },
        "error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 1,
              "type": "string"
            },
            "details": {
              "$ref": "#/$defs/__schema0"
            },
            "hint": {
              "minLength": 1,
              "type": "string"
            },
            "message": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        "ok": {
          "const": false,
          "type": "boolean"
        },
        "schema": {
          "const": "attest.cli-result",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "ok",
        "command",
        "error"
      ],
      "type": "object"
    }
  ]
}

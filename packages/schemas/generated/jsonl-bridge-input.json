{
  "$comment": "Runtime-only invariants: messages, turn_index, and conversation_id must appear together in the agent request.",
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "request": {
          "allOf": [
            {
              "additionalProperties": {},
              "type": "object"
            }
          ],
          "properties": {
            "callback": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "token": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "token"
                  ],
                  "type": "object"
                },
                {
                  "not": {}
                }
              ]
            },
            "case_id": {
              "type": "string"
            },
            "conversation_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "not": {}
                }
              ]
            },
            "input": {},
            "messages": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "role": {
                        "enum": [
                          "user",
                          "assistant"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "role",
                      "content"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                {
                  "not": {}
                }
              ]
            },
            "params": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "not": {}
                }
              ]
            },
            "protocol": {
              "enum": [
                "attest.agent-invocation"
              ],
              "type": "string"
            },
            "run_id": {
              "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
              "type": "string"
            },
            "state": {
              "anyOf": [
                {},
                {
                  "not": {}
                }
              ]
            },
            "turn_index": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "not": {}
                }
              ]
            }
          },
          "required": [
            "protocol",
            "run_id",
            "case_id",
            "input"
          ],
          "type": "object"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "type": {
          "enum": [
            "request"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "request_id",
        "request"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "type": {
          "enum": [
            "cancel"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "request_id"
      ],
      "type": "object"
    }
  ]
}

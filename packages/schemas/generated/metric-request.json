{
  "$comment": "Runtime-only invariants: span end_time must not precede start_time, and span ids must be unique.",
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "additionalProperties": {},
      "type": "object"
    }
  ],
  "properties": {
    "artifact_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "encoding": {
            "enum": [
              "utf8",
              "base64"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "inline"
            ],
            "type": "string"
          },
          "media_type": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "allOf": [
              {
                "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
              },
              {
                "pattern": "^(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255}(?:\\/(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255})*(?![\\s\\S])"
              }
            ],
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path",
          "media_type",
          "encoding",
          "content"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "case": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "anyOf": [
            {},
            {
              "not": {}
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "input": {},
        "params": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "not": {}
            }
          ]
        }
      },
      "required": [
        "id",
        "input"
      ],
      "type": "object"
    },
    "output": {},
    "protocol": {
      "enum": [
        "attest.metric-evaluation"
      ],
      "type": "string"
    },
    "trace": {
      "anyOf": [
        {
          "allOf": [
            {
              "additionalProperties": {},
              "type": "object"
            }
          ],
          "properties": {
            "schema": {
              "enum": [
                "attest.trace"
              ],
              "type": "string"
            },
            "spans": {
              "items": {
                "allOf": [
                  {
                    "additionalProperties": {},
                    "type": "object"
                  }
                ],
                "properties": {
                  "attributes": {
                    "anyOf": [
                      {
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        },
                        "type": "object"
                      },
                      {
                        "not": {}
                      }
                    ]
                  },
                  "end_time": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "events": {
                    "anyOf": [
                      {
                        "items": {
                          "allOf": [
                            {
                              "additionalProperties": {},
                              "type": "object"
                            }
                          ],
                          "properties": {
                            "attributes": {
                              "anyOf": [
                                {
                                  "additionalProperties": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "boolean"
                                      }
                                    ]
                                  },
                                  "type": "object"
                                },
                                {
                                  "not": {}
                                }
                              ]
                            },
                            "name": {
                              "type": "string"
                            },
                            "time": {
                              "format": "date-time",
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "time"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      {
                        "not": {}
                      }
                    ]
                  },
                  "input": {
                    "anyOf": [
                      {},
                      {
                        "not": {}
                      }
                    ]
                  },
                  "kind": {
                    "enum": [
                      "agent",
                      "llm",
                      "tool",
                      "retrieval",
                      "other"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "output": {
                    "anyOf": [
                      {},
                      {
                        "not": {}
                      }
                    ]
                  },
                  "parent_span_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "span_id": {
                    "type": "string"
                  },
                  "start_time": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "status": {
                    "allOf": [
                      {
                        "additionalProperties": {},
                        "type": "object"
                      }
                    ],
                    "properties": {
                      "code": {
                        "enum": [
                          "ok",
                          "error"
                        ],
                        "type": "string"
                      },
                      "message": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "not": {}
                          }
                        ]
                      }
                    },
                    "required": [
                      "code"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "span_id",
                  "parent_span_id",
                  "name",
                  "kind",
                  "start_time",
                  "end_time",
                  "status"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "schema",
            "trace_id",
            "spans"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "case",
    "output",
    "trace",
    "artifacts",
    "artifact_dir"
  ],
  "type": "object"
}

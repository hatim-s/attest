{
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "enum": [
        "eval.cancel"
      ],
      "type": "string"
    },
    "output": {
      "enum": [
        "human",
        "json"
      ],
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "schema": {
      "enum": [
        "attest.command-request"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "command",
    "run_id",
    "output"
  ],
  "type": "object"
}

{
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "ok": {
          "enum": [
            true
          ],
          "type": "boolean"
        },
        "project_hash_after": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_hash_before": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {},
        "schema": {
          "enum": [
            "attest.cli-result"
          ],
          "type": "string"
        },
        "warnings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "minLength": 1,
                "type": "string"
              },
              "details": {
                "anyOf": [
                  {},
                  {
                    "not": {}
                  }
                ]
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "not": {}
                  }
                ]
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "ok",
        "command",
        "project_hash_before",
        "project_hash_after",
        "result",
        "warnings"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 1,
              "type": "string"
            },
            "details": {
              "anyOf": [
                {},
                {
                  "not": {}
                }
              ]
            },
            "hint": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "not": {}
                }
              ]
            },
            "message": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "not": {}
                }
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        "ok": {
          "enum": [
            false
          ],
          "type": "boolean"
        },
        "schema": {
          "enum": [
            "attest.cli-result"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "ok",
        "command",
        "error"
      ],
      "type": "object"
    }
  ]
}

{
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "enum": [
        "attest.websocket-message"
      ],
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "type": {
      "enum": [
        "acknowledgement",
        "result",
        "error",
        "trace"
      ],
      "type": "string"
    },
    "value": {}
  },
  "required": [
    "protocol",
    "type",
    "request_id",
    "value"
  ],
  "type": "object"
}

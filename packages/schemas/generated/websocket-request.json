          },
          "type": "object"
        },
        "protocol": {
          "const": "attest.agent-invocation",
          "type": "string"
        },
        "run_id": {
          "format": "ulid",
          "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/__schema2"
        },
        "turn_index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol",
        "run_id",
        "case_id",
        "input"
      ],
      "type": "object"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "request_id",
    "request"
  ],
  "type": "object"

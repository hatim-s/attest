  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "attest.websocket-request",
      "type": "string"
    },
    "request": {
      "additionalProperties": {},
      "properties": {
        "case_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/__schema0"
        },
        "messages": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ],
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "params": {
          "additionalProperties": {

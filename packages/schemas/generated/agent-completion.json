{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema1"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "not": {
    "required": [
      "trace",
      "trace_ref"
    ]
  },
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "required": [
        "output"
      ]
    },
    {
      "not": {
        "required": [
          "output"
        ]
      },
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "artifacts": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "encoding": {
                "enum": [
                  "utf8",
                  "base64"
                ],
                "type": "string"
              },
              "kind": {
                "const": "inline",
                "type": "string"
              },
              "media_type": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "allOf": [
                  {
                    "pattern": "^(?![A-Za-z]:)"
                  },
                  {
                    "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
                  },
                  {
                    "pattern": "^(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255}(?:\\/(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255})*(?![\\s\\S])"
                  }
                ],
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "media_type",
              "encoding",
              "content"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "const": "reference",
                "type": "string"
              },
              "media_type": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "allOf": [
                  {
                    "pattern": "^(?![A-Za-z]:)"
                  },
                  {
                    "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
                  },
                  {
                    "pattern": "^(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255}(?:\\/(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255})*(?![\\s\\S])"
                  }
                ],
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "id"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "case_id": {
      "type": "string"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "output": {
      "$ref": "#/$defs/__schema0"
    },
    "protocol": {
      "const": "attest.agent-completion",
      "type": "string"
    },
    "run_id": {
      "format": "ulid",
      "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/__schema1"
    },
    "trace": {},
    "trace_ref": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "run_id",
    "case_id"
  ],
  "type": "object"
}

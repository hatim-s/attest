{
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "not": {
    "required": [
      "trace",
      "trace_ref"
    ]
  },
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "required": [
        "output"
      ]
    },
    {
      "not": {
        "required": [
          "output"
        ]
      },
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "artifacts": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "encoding": {
                    "enum": [
                      "utf8",
                      "base64"
                    ],
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "inline"
                    ],
                    "type": "string"
                  },
                  "media_type": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  },
                  "path": {
                    "allOf": [
                      {
                        "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
                      },
                      {
                        "pattern": "^(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255}(?:\\/(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255})*(?![\\s\\S])"
                      }
                    ],
                    "minLength": 1,
                    "pattern": "^(?![A-Za-z]:)",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "media_type",
                  "encoding",
                  "content"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "reference"
                    ],
                    "type": "string"
                  },
                  "media_type": {
                    "anyOf": [
                      {
                        "maxLength": 255,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "not": {}
                      }
                    ]
                  },
                  "path": {
                    "allOf": [
                      {
                        "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
                      },
                      {
                        "pattern": "^(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255}(?:\\/(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255})*(?![\\s\\S])"
                      }
                    ],
                    "minLength": 1,
                    "pattern": "^(?![A-Za-z]:)",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "id"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        {
          "not": {}
        }
      ]
    },
    "case_id": {
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "not": {}
                }
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "type": "object"
        },
        {
          "not": {}
        }
      ]
    },
    "output": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    },
    "protocol": {
      "enum": [
        "attest.agent-completion"
      ],
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    },
    "trace": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    },
    "trace_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "not": {}
        }
      ]
    }
  },
  "required": [
    "protocol",
    "run_id",
    "case_id"
  ],
  "type": "object"
}

              "pattern": "^(?!\\.{1,2}(?:\\/|$))[^\\s/\\\\](?:[^/\\\\]*[^\\s/\\\\])?(?:\\/(?!\\.{1,2}(?:\\/|$))[^\\s/\\\\](?:[^/\\\\]*[^\\s/\\\\])?)*(?![\\s\\S])",
              "type": "string"
            },
            {
              "not": {}
            }
          ]
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "input": {},
        "metric_overrides": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "not": {}
                      }
                    ]
                  },
                  "metric_id": {
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "type": "string"
                  },
                  "threshold": {
                    "anyOf": [
                      {
                        "type": "number"
                      },

                "required": [
                  "metric_id"
                ],
                "type": "object"
              },
              "type": "array"
            },
            {
              "not": {}
            }
          ]
        },
        "params": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "not": {}
            }
          ]
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "not": {}
            }
          ]
        }
      },
      "required": [
        "id",
        "input"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/TestCase",
  "$schema": "https://json-schema.org/draft/2020-12/schema"

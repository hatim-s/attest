{
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "additionalProperties": {},
      "type": "object"
    }
  ],
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "required": [
        "output"
      ]
    },
    {
      "not": {
        "required": [
          "output"
        ]
      },
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "artifacts": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "encoding": {
                "enum": [
                  "utf8",
                  "base64"
                ],
                "type": "string"
              },
              "kind": {
                "enum": [
                  "inline"
                ],
                "type": "string"
              },
              "media_type": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "allOf": [
                  {
                    "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
                  },
                  {
                    "pattern": "^(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255}(?:\\/(?!\\.{1,2}(?:\\/|(?![\\s\\S])))[^/\\\\\\p{Cc}]{1,255})*(?![\\s\\S])"
                  }
                ],
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "media_type",
              "encoding",
              "content"
            ],
            "type": "object"
          },
          "type": "array"
        },
        {
          "not": {}
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "not": {}
                }
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "type": "object"
        },
        {
          "not": {}
        }
      ]
    },
    "output": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    },
    "protocol": {
      "enum": [
        "attest.agent-invocation"
      ],
      "type": "string"
    },
    "state": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    },
    "trace": {
      "anyOf": [
        {},
        {
          "not": {}
        }
      ]
    }
  },
  "required": [
    "protocol"
  ],
  "type": "object"
}

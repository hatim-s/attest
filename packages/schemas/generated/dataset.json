{
  "$defs": {
    "DatasetResource": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "case_schema": {
          "enum": [
            "attest.case"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "counts": {
                  "additionalProperties": false,
                  "properties": {
                    "inserted": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "read": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "skipped": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "updated": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "read",
                    "inserted",
                    "updated",
                    "skipped"
                  ],
                  "type": "object"
                },
                "imported_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "key_field": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "not": {}
                    }
                  ]
                },
                "mapping": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "destination": {
                        "pattern": "^(?:id|input(?:\\.(?:[A-Za-z0-9_-]|\\\\[.\\\\])+)*|expected(?:\\.(?:[A-Za-z0-9_-]|\\\\[.\\\\])+)*|params(?:\\.(?:[A-Za-z0-9_-]|\\\\[.\\\\])+)+|tags|folder|metric_overrides)$",
                        "type": "string"
                      },
                      "source": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "destination",
                      "source"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "project_relative_source_path": {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$"
                        }
                      ],
                      "minLength": 1,
                      "pattern": "^(?![A-Za-z]:)",
                      "type": "string"
                    },
                    {
                      "not": {}
                    }
                  ]
                },
                "source_content_hash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "source_type": {
                  "enum": [
                    "csv",
                    "json",
                    "jsonl"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "source_type",
                "mapping",
                "imported_at",
                "source_content_hash",
                "counts"
              ],
              "type": "object"
            },
            {
              "not": {}
            }
          ]
        },
        "schema": {
          "enum": [
            "attest.dataset"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "case_schema",
        "id",
        "name",
        "case_count"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/DatasetResource",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

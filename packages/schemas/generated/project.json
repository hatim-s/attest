{
  "$comment": "Runtime-only invariants include canonical manifest paths, cross-resource references, duplicate identifiers, and resolved case-id collisions.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "eval_timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "output_cap_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "format": "ulid",
      "pattern": "^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content_hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$",
                "type": "string"
              },
              "schema": {
                "anyOf": [
                  {
                    "const": "attest.agent",
                    "type": "string"
                  },
                  {
                    "const": "attest.agent/v2",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "id",
              "path",
              "content_hash",
              "schema"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "datasets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "data_content_hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "data_path": {
                "minLength": 1,
                "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "metadata_content_hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "metadata_path": {
                "minLength": 1,
                "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$",
                "type": "string"
              },
              "schema": {
                "anyOf": [
                  {
                    "const": "attest.dataset",
                    "type": "string"
                  },
                  {
                    "const": "attest.dataset/v2",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "id",
              "schema",
              "data_path",
              "data_content_hash",
              "metadata_path",
              "metadata_content_hash"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "metrics": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content_hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$",
                "type": "string"
              },
              "schema": {
                "anyOf": [
                  {
                    "const": "attest.metric",
                    "type": "string"
                  },
                  {
                    "const": "attest.metric/v2",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "id",
              "path",
              "content_hash",
              "schema"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "tests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content_hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "pattern": "^(?![\\\\/])(?!(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+$",
                "type": "string"
              },
              "schema": {
                "anyOf": [
                  {
                    "const": "attest.test",
                    "type": "string"
                  },
                  {
                    "const": "attest.test/v2",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "id",
              "path",
              "content_hash",
              "schema"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "agents",
        "tests",
        "datasets",
        "metrics"
      ],
      "type": "object"
    },
    "schema": {
      "anyOf": [
        {
          "const": "attest.project",
          "type": "string"
        },
        {
          "const": "attest.project/v2",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "schema",
    "project_id",
    "name",
    "resources"
  ],
  "type": "object"
}

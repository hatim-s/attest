{
  "name": "@attest/runtime",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@attest/contracts": "workspace:*",
    "@attest/core": "workspace:*",
    "@tanstack/ai": "0.43.0",
    "@tanstack/ai-anthropic": "0.16.4",
    "@tanstack/ai-openai": "0.18.0",
    "ajv": "^8.20.0",
    "zod": "^4",
    "@attest/executor": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:node": "node --test src/eval/_tests_/portability.check.mjs",
    "test:bun": "bun test ./src/eval/_tests_/portability.check.mjs",
    "prepublishOnly": "node ../../scripts/block-source-publish.mjs"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^3"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0",
    "bun": ">=1.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatim-s/attest.git",
    "directory": "packages/runtime"
  },
  "description": "Evaluation scheduling, lifecycle hooks, and metrics."
}

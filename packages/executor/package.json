{
  "name": "@attest/executor",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@attest/contracts": "workspace:*",
    "@vercel/sandbox": "3.3.0",
    "just-bash": "3.4.2"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:node": "node --test src/_tests_/portability.check.mjs",
    "test:bun": "bun test ./src/_tests_/portability.check.mjs",
    "prepublishOnly": "node ../../scripts/block-source-publish.mjs"
  },
  "devDependencies": {
    "vitest": "^3",
    "fast-check": "^4.9.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.15.0",
    "bun": ">=1.4"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatim-s/attest.git",
    "directory": "packages/executor"
  },
  "description": "Agent invocation, transports, and isolated case environments."
}

{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/conformance/src/load-fixtures.ts"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "package.json",
        "$TURBO_ROOT$/packages/schemas/generated/**",
        "$TURBO_ROOT$/conformance/src/load-fixtures.ts",
        "$TURBO_ROOT$/conformance/fixtures/**"
      ]
    }
  }
}

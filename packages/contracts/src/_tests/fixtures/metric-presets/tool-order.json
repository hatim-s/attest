{
  "schema": "attest.metric-preset/v1",
  "id": "tool-order",
  "name": "Tool order",
  "description": "Require tool-call names to appear in one chronological order.",
  "required_inputs": ["tool_order"],
  "configurable_fields": [],
  "definition": {
    "kind": "assertion",
    "assertions": [{ "tool_calls": { "order": ["first-tool", "second-tool"] } }]
  }
}

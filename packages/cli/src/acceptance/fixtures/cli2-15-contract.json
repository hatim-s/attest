  "journeys": [
    {
      "id": "native-author-import-evaluate",
      "example_root": "examples/native-cli",
      "seed_files": {
        "agent.mjs": "let input = '';\nprocess.stdin.setEncoding('utf8');\nfor await (const chunk of process.stdin) input += chunk;\nconst request = JSON.parse(input);\nprocess.stdout.write(JSON.stringify({ protocol: 'attest.agent/v1alpha1', output: request.input }));\n",
        "cases.jsonl": "{\"id\":\"refund-basic\",\"input\":\"refund policy\",\"expected\":\"refund policy\"}\n"
      },
      "commands": [
        {
          "display": "attest project init . --name support --non-interactive --output json",
          "argv": [
            "project",
            "init",
            ".",
            "--name",
            "support",
            "--non-interactive",
            "--output",
            "json"
          ],
          "exit_code": 0,
          "ok": true,
          "command": "project.init",
          "artifact_documents": {
            "attest.project.json": {
              "schema": "attest.project/v2",
              "name": "support",
              "resources": { "agents": [], "datasets": [], "metrics": [], "tests": [] }
            }
          },
          "artifacts_present": ["attest.project.json"],
          "artifacts_absent": ["attest.config.json", ".attest/runs.db"],
          "tree_changes": ["attest.project.json"]
        },
        {
          "display": "attest agent add support --argv-json '[\"node\",\"./agent.mjs\"]' --timeout 5s --output json",
          "argv": [
            "agent",
            "add",
            "support",
            "--argv-json",
            "[\"$NODE\",\"./agent.mjs\"]",
            "--timeout",
            "5s",
            "--output",
            "json"
          ],
          "exit_code": 0,
          "ok": true,
          "command": "agent.add",
          "artifact_documents": {
            "attest.project.json": { "schema": "attest.project/v2", "name": "support" },
            "attest/agents/support.json": { "schema": "attest.agent/v2", "id": "support" }
          },
          "artifacts_present": ["attest/agents/support.json"],
          "artifacts_absent": [".attest/runs.db"],
          "tree_changes": [
            ".attest/",
            ".attest/transactions/",
            "attest.project.json",
            "attest/",
            "attest/agents/",
            "attest/agents/support.json"
          ]
        },
        {
          "display": "attest agent test support --input '\"ping\"' --output json",
          "argv": ["agent", "test", "support", "--input", "\"ping\"", "--output", "json"],
          "exit_code": 0,
          "ok": true,
          "command": "agent.test",
          "artifact_documents": {
            "attest.project.json": { "schema": "attest.project/v2", "name": "support" },
            "attest/agents/support.json": { "schema": "attest.agent/v2", "id": "support" }
          },
          "artifacts_present": ["attest/agents/support.json"],
          "artifacts_absent": [".attest/runs.db"],
          "tree_changes": []
        },
        {
          "display": "attest metric add exact --preset output-equals --value '\"refund policy\"' --output json",
          "argv": [
            "metric",
            "add",
            "exact",
            "--preset",
            "output-equals",
            "--value",
            "\"refund policy\"",
            "--output",
            "json"
          ],
          "exit_code": 0,
          "ok": true,
          "command": "metric.add",
          "artifact_documents": {
            "attest.project.json": { "schema": "attest.project/v2", "name": "support" },
            "attest/metrics/exact.json": { "schema": "attest.metric/v2", "id": "exact" }
          },
          "artifacts_present": ["attest/metrics/exact.json"],
          "artifacts_absent": [".attest/runs.db"],
          "tree_changes": ["attest.project.json", "attest/metrics/", "attest/metrics/exact.json"]
        },
        {
          "display": "attest test add smoke --agent support --metric exact --output json",
          "argv": [
            "test",
            "add",
            "smoke",
            "--agent",
            "support",
            "--metric",
            "exact",
            "--output",
            "json"
          ],
          "exit_code": 0,
          "ok": true,
          "command": "test.add",
          "artifact_documents": {
            "attest.project.json": { "schema": "attest.project/v2", "name": "support" },
            "attest/tests/smoke.json": { "schema": "attest.test/v2", "id": "smoke" }
          },
          "artifacts_present": ["attest/tests/smoke.json"],
          "artifacts_absent": [".attest/runs.db"],
          "tree_changes": ["attest.project.json", "attest/tests/", "attest/tests/smoke.json"]
        },
        {
          "display": "attest test case import smoke ./cases.jsonl --output json",
          "argv": ["test", "case", "import", "smoke", "./cases.jsonl", "--output", "json"],
          "exit_code": 0,
          "ok": true,
          "command": "test.case.import",
          "artifact_documents": {
            "attest.project.json": { "schema": "attest.project/v2", "name": "support" },
            "attest/tests/smoke.json": { "schema": "attest.test/v2", "id": "smoke" }
          },
          "artifacts_present": ["attest/tests/smoke.json"],
          "artifacts_absent": [".attest/runs.db"],
          "tree_changes": ["attest.project.json", "attest/tests/smoke.json"]
        },
        {
          "display": "attest eval run smoke --output json",
          "argv": ["eval", "run", "smoke", "--output", "json"],
          "exit_code": 0,
          "ok": true,
          "command": "eval.run",
          "artifact_documents": {},
          "artifacts_present": [".attest/runs.db"],
          "artifacts_absent": ["attest.config.json"],
          "tree_changes": [".attest/eval-runs/", ".attest/runs.db"]
        }
      ]
    },

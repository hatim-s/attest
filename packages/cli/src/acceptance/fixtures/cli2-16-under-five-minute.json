{
  "schema": "attest.cli2-16-under-five-minute/v1",
  "budget_ms": 300000,
  "per_command_timeout_ms": 30000,
  "timing": {
    "clock": "performance.now monotonic wall time",
    "start": "Immediately before each actor CLI process starts; the actor total is the sum of those process intervals.",
    "stop": "When each actor CLI process exits, or when the long-running view command reports loopback readiness.",
    "included": [
      "Every Attest process startup and execution in the actor journey",
      "Native agent probes and eval execution",
      "Run inspection, report generation, view startup through loopback readiness, deliberate failure, and error-catalog lookup"
    ],
    "excluded": [
      "Installing Node and the already-packed Attest CLI",
      "Building or packing the repository checkout",
      "Staging the actor's pre-existing agent and case or dataset fixtures",
      "Snapshot hashing, structured-output parsing, HTML and readiness reads, process cleanup, and test assertions performed outside each CLI interval"
    ],
    "retries": 0,
    "aggregation": "Sum only the independently measured CLI process intervals for each actor; each actor must pass independently on every required operating system, and averages or pooled times are forbidden."
  },
  "prerequisites": {
    "warm": [
      "Node.js 22 or newer is on PATH.",
      "A pristine production-packed Attest CLI runtime and all of its production dependencies are installed separately for each actor before timing starts.",
      "The actor starts with the documented quickstart and the versioned CLI help, schema, and error surfaces available.",
      "No network access, credentials, provider SDK, repository source import, or ambient workspace link is required."
    ],
    "cold": [
      "The journey runs in a new writable temporary directory.",
      "Only the task-owned native agent and CSV, JSONL, or command-request inputs exist before timing starts.",
      "No attest.project.json, attest resource directory, .attest directory, run store, report artifact, lock, or transaction residue exists.",
      "The first discovery command is the first invocation of the installed CLI in that journey; operating-system filesystem and executable caches are uncontrolled."
    ]
  },
  "cross_platform": {
    "required_ci_operating_systems": ["ubuntu-latest", "macos-latest"],
    "node_major": 22,
    "windows_required": false,
    "rules": [
      "The harness invokes executables with argv arrays and never through a shell.",
      "Fixture and artifact paths are resolved with Node path APIs.",
      "The same commands, exit codes, structured documents, no-write expectations, and five-minute budget apply on Linux and macOS.",
      "Windows process supervision remains outside the initial v2 gate under North Star Section 13."
    ]
  },
  "fixture_files": [
    "native-agent.mjs",
    "human-cases.csv",
    "agent-cases.jsonl",
    "agent-add.json",
    "metric-add.json"
  ],
  "actors": [
    {
      "id": "human-copy-paste",
      "description": "A human follows documented, copy-paste commands in a terminal without editing generated JSON or YAML.",
      "commands": [
        {
          "id": "discover",
          "argv": ["help"],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["Usage:", "agent", "test", "metric", "eval"],
          "no_write": true
        },
        {
          "id": "init",
          "argv": ["project", "init", ".", "--name", "support", "--non-interactive"],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["support"],
          "artifacts_present": ["attest.project.json"]
        },
        {
          "id": "add-agent",
          "argv": [
            "agent",
            "add",
            "support",
            "--argv-json",
            "[\"node\",\"./native-agent.mjs\"]",
            "--timeout",
            "5s"
          ],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["support", "attest agent test support"],
          "artifacts_present": ["attest/agents/support.json"]
        },
        {
          "id": "probe-agent",
          "argv": ["agent", "test", "support", "--input", "\"ping\""],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["support"],
          "no_write": true
        },
        {
          "id": "add-metric",
          "argv": [
            "metric",
            "add",
            "exact",
            "--preset",
            "output-contains",
            "--value",
            "\"policy\""
          ],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["exact"],
          "artifacts_present": ["attest/metrics/exact.json"]
        },
        {
          "id": "add-test",
          "argv": ["test", "add", "smoke", "--agent", "support", "--metric", "exact"],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["smoke"],
          "artifacts_present": ["attest/tests/smoke.json"]
        },
        {
          "id": "import-dataset",
          "argv": [
            "test",
            "dataset",
            "import",
            "smoke",
            "./human-cases.csv",
            "--as",
            "regression",
            "--map",
            "input=prompt",
            "--map",
            "expected=ideal",
            "--key",
            "external_id"
          ],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["regression", "2"],
          "artifacts_present": [
            "attest/datasets/regression.jsonl",
            "attest/datasets/regression.meta.json"
          ]
        },
        {
          "id": "run-eval",
          "argv": ["eval", "run", "smoke"],
          "exit_code": 0,
          "output": "human",
          "capture_run_id": true,
          "required_stdout": ["Result: PASS (exit 0)"],
          "acceptance_stdout": [
            "attest report $RUN_ID",
            "attest view --no-open",
            "Compare with a baseline run:",
            "attest diff <base-run-id> $RUN_ID"
          ],
          "artifacts_present": [".attest/runs.db"]
        },
        {
          "id": "inspect-run",
          "argv": ["show", "run", "$RUN_ID", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "show",
          "result_schema": "run",
          "no_write": true
        },
        {
          "id": "validate-comparison-template",
          "argv": ["help", "diff", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "help",
          "result_schema": "attest.cli-help/v1",
          "help_usage": "attest diff [options] <base-run-id> <candidate-run-id>",
          "help_arguments": ["base-run-id", "candidate-run-id"],
          "no_write": true
        },
        {
          "id": "write-report",
          "argv": ["report", "$RUN_ID"],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["2-case report", "attest-report-$RUN_ID.html"],
          "artifacts_present": ["attest-report-$RUN_ID.html"]
        },
        {
          "id": "open-view",
          "argv": ["view", "--no-open"],
          "exit_code": 0,
          "output": "human",
          "readiness_probe": "view",
          "required_stdout": ["Attest view: http://127.0.0.1:", "Press Ctrl+C to stop."]
        },
        {
          "id": "structured-failure",
          "argv": ["agent", "add", "incomplete", "--output", "json"],
          "exit_code": 2,
          "output": "json",
          "command": "agent.add",
          "error_code": "cli_missing_input",
          "required_error_fields": ["path", "hint", "retryable"],
          "no_write": true,
          "artifacts_absent": ["attest/agents/incomplete.json"]
        },
        {
          "id": "identify-repair",
          "argv": ["errors", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "errors",
          "result_schema": "attest.cli-errors/v1",
          "catalog_error_code": "cli_missing_input",
          "no_write": true
        }
      ]
    },
    {
      "id": "coding-agent-non-interactive",
      "description": "A coding agent discovers machine contracts and uses flags or checked-in request documents without scraping prose or editing generated resources.",
      "commands": [
        {
          "id": "discover",
          "argv": ["help", "test", "case", "import", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "help",
          "result_schema": "attest.cli-help/v1",
          "no_write": true
        },
        {
          "id": "discover-schema",
          "argv": ["schema", "print", "attest.command-request/v2", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "schema.print",
          "no_write": true
        },
        {
          "id": "discover-errors",
          "argv": ["errors", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "errors",
          "result_schema": "attest.cli-errors/v1",
          "no_write": true
        },
        {
          "id": "init",
          "argv": [
            "project",
            "init",
            ".",
            "--name",
            "support",
            "--non-interactive",
            "--output",
            "json"
          ],
          "exit_code": 0,
          "output": "json",
          "command": "project.init",
          "artifacts_present": ["attest.project.json"]
        },
        {
          "id": "add-agent-request",
          "argv": ["agent", "add", "--from-json", "./agent-add.json", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "agent.add",
          "artifacts_present": ["attest/agents/support.json"]
        },
        {
          "id": "probe-agent",
          "argv": ["agent", "test", "support", "--input", "\"ping\"", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "agent.test",
          "no_write": true
        },
        {
          "id": "add-metric-request",
          "argv": ["metric", "add", "--from-json", "./metric-add.json", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "metric.add",
          "artifacts_present": ["attest/metrics/exact.json"]
        },
        {
          "id": "add-test",
          "argv": [
            "test",
            "add",
            "smoke",
            "--agent",
            "support",
            "--metric",
            "exact",
            "--output",
            "json"
          ],
          "exit_code": 0,
          "output": "json",
          "command": "test.add",
          "artifacts_present": ["attest/tests/smoke.json"]
        },
        {
          "id": "import-cases",
          "argv": ["test", "case", "import", "smoke", "./agent-cases.jsonl", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "test.case.import",
          "artifacts_present": ["attest/tests/smoke.json"]
        },
        {
          "id": "run-eval",
          "argv": ["eval", "run", "smoke", "--output", "jsonl"],
          "exit_code": 0,
          "output": "jsonl",
          "capture_run_id": true,
          "artifacts_present": [".attest/runs.db"]
        },
        {
          "id": "inspect-run",
          "argv": ["show", "run", "$RUN_ID", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "show",
          "result_schema": "run",
          "no_write": true
        },
        {
          "id": "write-report",
          "argv": ["report", "$RUN_ID", "--output", "artifacts/agent-run.html"],
          "exit_code": 0,
          "output": "human",
          "required_stdout": ["2-case report", "artifacts/agent-run.html"],
          "artifacts_present": ["artifacts/agent-run.html"]
        },
        {
          "id": "structured-failure",
          "argv": ["agent", "add", "incomplete", "--output", "json"],
          "exit_code": 2,
          "output": "json",
          "command": "agent.add",
          "error_code": "cli_missing_input",
          "required_error_fields": ["path", "hint", "retryable"],
          "no_write": true,
          "artifacts_absent": ["attest/agents/incomplete.json"]
        },
        {
          "id": "identify-repair",
          "argv": ["errors", "--output", "json"],
          "exit_code": 0,
          "output": "json",
          "command": "errors",
          "result_schema": "attest.cli-errors/v1",
          "catalog_error_code": "cli_missing_input",
          "no_write": true
        }
      ]
    }
  ]
}

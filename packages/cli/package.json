{
  "name": "@attest/cli",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "attest": "./dist/cli.js"
  },
  "dependencies": {
    "@attest/contracts": "workspace:*",
    "@attest/core": "workspace:*",
    "@attest/local": "workspace:*",
    "commander": "^15.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/block-source-publish.mjs"
  },
  "devDependencies": {
    "vitest": "^3"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "description": "Command-line agent evaluation and local results dashboard.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatim-s/attest.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hatim-s/attest#readme",
  "bugs": {
    "url": "https://github.com/hatim-s/attest/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22.15.0",
    "bun": ">=1.4"
  }
}
